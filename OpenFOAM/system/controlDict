FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


// Steady RANS: one 'time step' = one SIMPLE iteration.
application     simpleFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

// Iteration limit; residualControl in fvSolution stops earlier if converged.
endTime         5000;

deltaT          1;

writeControl    timeStep;

writeInterval   500;

// Keep only the last 2 written iterations (each ~1-2 GB on the medium mesh).
purgeWrite      2;

writeFormat     binary;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

functions
{

    // Convergence monitoring: initial residuals per iteration
    residuals
    {
        type            solverInfo;
        libs            (utilityFunctionObjects);
        fields          (p U k omega);
        writeControl    timeStep;
        writeInterval   1;
    }

    // Lift/drag on the half wing. Freestream is along +x (the wing is
    // pitched in the geometry), so lift is +y and drag +x.
    // Aref = chord x span to tip = 1.2192 x 0.9144 m.
    forceCoeffs
    {
        type            forceCoeffs;
        libs            (forces);
        patches         (wing);
        rho             rhoInf;
        rhoInf          1.225;
        CofR            (0 0 0);
        liftDir         (0 1 0);
        dragDir         (1 0 0);
        pitchAxis       (0 0 1);
        magUInf         51.816;
        lRef            1.2192;
        Aref            1.11484;
        writeControl    timeStep;
        writeInterval   1;
        log             on;
    }

    QCriterion
    {
        type            Q;
        libs            (fieldFunctionObjects);
        
        writeControl    writeTime;
        log             on;
    }

    vorticity
    {
        type            vorticity;
        libs            (fieldFunctionObjects);
        writeControl    writeTime;
        writeFields     yes;
        log             on;
    }

    // Near-wall check for the wall-resolved mesh: target first-cell y+ ~ 1
    // (mean ~0.7, up to ~2 at the leading-edge suction peak). Writes the
    // yPlus field and logs min/max/average y+ on the wing per write.
    yPlus
    {
        type            yPlus;
        libs            (fieldFunctionObjects);
        writeControl    writeTime;
        log             on;
    }

    wallShearStress
    {
        type            wallShearStress;
        libs            (fieldFunctionObjects);
        patches         (wing);
        writeControl    writeTime;
        log             off;
    }

    CpStatic
    {
        type            pressure;
        libs            (fieldFunctionObjects);

        mode            staticCoeff;

        p               p;
        U               U;
        
        rho             rhoInf;
        rhoInf          1.225;      

        pInf            0.0;        
        UInf            (51.816 0 0);    

        result          CpStatic;   
        writeControl    writeTime;
        log             off;
    }

    CpTotal
    {
        type            pressure;
        libs            (fieldFunctionObjects);

        mode            totalCoeff;

        p               p;
        U               U;
        
        rho             rhoInf;
        rhoInf          1.225;      

        pInf            0.0;        
        UInf            (51.816 0 0);

        result          CpTotal;
        writeControl    writeTime;
        log             off;
    }

    // ── Probe / sample locations ──────────────────────────────────────────
    // sampleDict-based probes will be added here once the pre-processed
    // experimental probe locations are confirmed.  Placeholder:
    //
    // probes
    // {
