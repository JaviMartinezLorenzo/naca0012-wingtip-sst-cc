FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      surfaceFeatureExtractDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

wing.stl
{
    // How to obtain raw features (extractFromFile || extractFromSurface)
    extractionMethod    extractFromSurface;

    // Mark edges whose adjacent surface normals are at an angle less
    // than includedAngle as features
    // - 0  : selects no edges
    // - 180: selects all edges
    extractFromSurfaceCoeffs
    {
        includedAngle   150;
    }

    // Keep only the blunt trailing-edge corners (refined to level 8 and used
    // for feature snapping in snappyHexMeshDict).
    // - openEdges no: the STL is open at the root (closed by the symmetry
    //   plane) and has a non-conforming seam where the straight wing meets
    //   the revolved tip; both would otherwise be refined along their length.
    // - insideBox: drops a few spurious 'feature' edges from sliver
    //   triangles on the revolved tip surface (x ~ 0.13-0.24 m).
    subsetFeatures
    {
        nonManifoldEdges no;
        openEdges        no;
        insideBox        (0.85 -0.25 -0.01) (0.95 0.0 0.95);
    }


    // Write options

    // Write features to obj format for postprocessing
    writeObj            yes;
}


