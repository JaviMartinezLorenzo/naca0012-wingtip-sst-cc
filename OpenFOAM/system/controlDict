FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


// Steady RANS: one 'time step' = one SIMPLE iteration.
application     simpleFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

// Iterations. Residuals level off near 1e-5 and never reach residualControl
// in fvSolution, so this decides the run length. With SST + Spalding the
// forces settle by ~330 and the wake core (wake_x* monitors) by ~650
// iterations (2500-iteration check, README "Wake convergence"). 1000 leaves a
// margin; check each run with scripts/postprocess/wake_convergence.py and
// raise endTime + Allrun.sh --solve-only if a model has not settled.
endTime         1000;

deltaT          1;

writeControl    timeStep;

writeInterval   500;

// Keep only the last 2 written iterations (each ~1-2 GB on the medium mesh).
purgeWrite      2;

writeFormat     binary;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

// Common settings of the wake_x* monitors below (not a function object).
wakeMonitor
{
    type            volFieldValue;
    libs            (fieldFunctionObjects);
    regionType      cellZone;
    operation       min;
    fields          (p);
    writeFields     false;
    writeControl    timeStep;
    writeInterval   1;
    log             false;
}

functions
{

    // Convergence monitoring: initial residuals per iteration
    residuals
    {
        type            solverInfo;
        libs            (utilityFunctionObjects);
        fields          (p U k omega);
        writeControl    timeStep;
        writeInterval   1;
    }

    // Lift/drag on the half wing. Freestream is along +x (the wing is
    // pitched in the geometry), so lift is +y and drag +x.
    // Aref = chord x span to tip = 1.2192 x 0.9144 m.
    forceCoeffs
    {
        type            forceCoeffs;
        libs            (forces);
        patches         (wing);
        rho             rhoInf;
        rhoInf          1.225;
        CofR            (0 0 0);
        liftDir         (0 1 0);
        dragDir         (1 0 0);
        pitchAxis       (0 0 1);
        magUInf         51.816;
        lRef            1.2192;
        Aref            1.11484;
        writeControl    timeStep;
        writeInterval   1;
        log             on;
    }

    QCriterion
    {
        type            Q;
        libs            (fieldFunctionObjects);
        
        writeControl    writeTime;
        log             on;
    }

    vorticity
    {
        type            vorticity;
        libs            (fieldFunctionObjects);
        writeControl    writeTime;
        writeFields     yes;
        log             on;
    }

    // Near-wall check for the wall-resolved mesh: target first-cell y+ ~ 1
    // (mean ~0.7, up to ~2 at the leading-edge suction peak). Writes the
    // yPlus field and logs min/max/average y+ on the wing per write.
    yPlus
    {
        type            yPlus;
        libs            (fieldFunctionObjects);
        writeControl    writeTime;
        log             on;
    }

    wallShearStress
    {
        type            wallShearStress;
        libs            (fieldFunctionObjects);
        patches         (wing);
        writeControl    writeTime;
        log             off;
    }

    CpStatic
    {
        type            pressure;
        libs            (fieldFunctionObjects);

        mode            staticCoeff;

        p               p;
        U               U;
        
        rho             rhoInf;
        rhoInf          1.225;      

        pInf            0.0;        
        UInf            (51.816 0 0);    

        result          CpStatic;   
        writeControl    writeTime;
        log             off;
    }

    CpTotal
    {
        type            pressure;
        libs            (fieldFunctionObjects);

        mode            totalCoeff;

        p               p;
        U               U;
        
        rho             rhoInf;
        rhoInf          1.225;      

        pInf            0.0;        
        UInf            (51.816 0 0);

        result          CpTotal;
        writeControl    writeTime;
        log             off;
    }

    // ── Wake convergence monitors ─────────────────────────────────────────
    // Minimum p in thin slabs at the measured wake stations (cellZones from
    // system/topoSetDict) = vortex-core pressure, every iteration.
    // Cp_min = p / (0.5 U_inf^2) = p / 1342.45 (kinematic p, p_inf = 0).
    // The wake settles much later than the forces; judge convergence with
    // scripts/postprocess/wake_convergence.py, which reads these files and
    // postProcessing/forceCoeffs.
    wake_x0907 { $wakeMonitor; name wake_x0907; }   // TE + 6 mm
    wake_x1054 { $wakeMonitor; name wake_x1054; }
    wake_x1201 { $wakeMonitor; name wake_x1201; }
    wake_x1452 { $wakeMonitor; name wake_x1452; }
    wake_x1727 { $wakeMonitor; name wake_x1727; }   // last station, x/c = 1.42

    // ── Probe / sample locations ──────────────────────────────────────────
    // sampleDict-based probes will be added here once the pre-processed
    // experimental probe locations are confirmed.  Placeholder:
    //
    // probes
    // {
