FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            calculated;
        value           uniform 0;
    }

    outlet
    {
        type            calculated;
        value           uniform 0;
    }

    top
    {
        type            zeroGradient;
    }

    bottom
    {
        type            zeroGradient;
    }

    front
    {
        type            zeroGradient;
    }

    back
    {
        type            symmetryPlane;
    }

    // Spalding's law: continuous over the whole y+ range and driven by the
    // wall velocity gradient (not by k), so it acts as a low-Re condition at
    // y+ ~ 1 and still behaves on the few faces with a thicker first cell.
    // nutkWallFunction switched to a log-law wherever its k-based y+ estimate
    // exceeded 11.5, even with a 10 um first cell. The yPlus function object
    // now reports the wall-shear y+.
    wing
    {
        type            nutUSpaldingWallFunction;
        value           uniform 0;
    }
}


